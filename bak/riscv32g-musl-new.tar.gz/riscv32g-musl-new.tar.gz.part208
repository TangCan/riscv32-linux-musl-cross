  -q --quick       (застаріла - ігнорується)
  -n --noprescan   Не виконувати сканування для перетворення commons у defs
  -d --debug       Виведення інформації про те, що виконується
  @<файл>          Читати ключі з <файла>
  -h --help        Виведення цієї інформації
  -v --version     Виведення номера версії програми
