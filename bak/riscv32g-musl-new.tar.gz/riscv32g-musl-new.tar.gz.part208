      { return { _Base::begin(), this }; }

      [[__nodiscard__]]
      iterator
      end() noexcept
      { return { _Base::end(), this }; }

      [[__nodiscard__]]
      const_iterator
      end() const noexcept
      { return { _Base::end(), this }; }

      [[__nodiscard__]]
      const_iterator
      cbegin() const noexcept
      { return { _Base::cbegin(), this }; }

      [[__nodiscard__]]
      const_iterator
      cbefore_begin() const noexcept
      { return { _Base::cbefore_begin(), this }; }

      [[__nodiscard__]]
