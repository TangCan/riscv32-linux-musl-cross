/* Treat a TREE_VEC as a range of trees, e.g.
   for (tree e : tree_vec_range (v)) { ... }  */

class tree_vec_range
{
  tree v;
public:
  tree_vec_range(tree v) : v(v) { }
  tree *begin() { return TREE_VEC_BEGIN (v); }
  tree *end() { return TREE_VEC_END (v); }
};

